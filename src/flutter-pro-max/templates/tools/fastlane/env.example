# Fastlane Environment Configuration Template
# Copy this file to .env.fastlane in your project root and fill in your credentials.
# NEVER commit .env.fastlane to version control!

# ------------------------------------------------------------------------------
# Android Settings
# ------------------------------------------------------------------------------
ANDROID_PACKAGE_NAME=com.example.app
GOOGLE_PLAY_JSON_KEY_FILE=android/fastlane/google-play-key.json
FIREBASE_APP_ID_ANDROID=1:1234567890:android:abcdef123456

# ------------------------------------------------------------------------------
# iOS Settings
# ------------------------------------------------------------------------------
IOS_APP_IDENTIFIER=com.example.app
APPLE_ID=developer@example.com
APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_ITC_TEAM_ID=12345678
MATCH_PASSWORD=secret_password_for_certificates_repo
MATCH_GIT_URL=git@github.com:your-org/certificates.git
