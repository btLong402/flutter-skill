# Fastfile for iOS
default_platform(:ios)

platform :ios do
  before_all do
    # Load environment variables if .env.fastlane exists
    Dotenv.overload("../.env.fastlane") if File.exist?("../.env.fastlane")
  end

  desc "Sync code signing certificates and provisioning profiles via Match"
  lane :certificates do
    match(
      type: "appstore",
      readonly: is_ci,
      app_identifier: ENV["IOS_APP_IDENTIFIER"] || "com.example.app"
    )
  end

  desc "Build debug IPA (Ad-Hoc / Development)"
  lane :build_dev do
    gym(
      scheme: "dev",
      export_method: "ad-hoc",
      clean: true,
      output_directory: "build/ios/dev"
    )
  end

  desc "Build production IPA for App Store / TestFlight"
  lane :build_prod do
    certificates
    gym(
      scheme: "prod",
      export_method: "app-store",
      clean: true,
      output_directory: "build/ios/prod"
    )
  end

  desc "Distribute build to Apple TestFlight"
  lane :beta_testflight do
    build_prod
    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )
  end

  desc "Deploy build to Apple App Store"
  lane :deploy_app_store do
    build_prod
    upload_to_app_store(
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false
    )
  end
end
